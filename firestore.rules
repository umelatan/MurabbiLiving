rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read, write: if request.auth != null;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null;
      }
      match /{subcollection}/{docId}/{subSubcollection}/{subDocId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
